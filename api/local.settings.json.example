{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",

    "AUDIO_STORAGE_CONNECTION": "DefaultEndpointsProtocol=https;AccountName=<CUENTA>;AccountKey=<LLAVE>;EndpointSuffix=core.windows.net",
    "AUDIO_CONTAINER": "grabaciones",
    "SAS_TTL_MINUTES": "15",

    "SPEECH_KEY": "<llave del recurso Azure AI Speech>",
    "SPEECH_REGION": "eastus2"
  },
  "Host": {
    "CORS": "http://localhost:5500,http://127.0.0.1:5500",
    "CORSCredentials": false
  }
}
